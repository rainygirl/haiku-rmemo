	$"0422354047405522430A045E355E43405540470A0440235E35404722350A043D"
	$"2A533751383B2B0A04382D4D3A4C3B362E0A043230483D463E31310A042D343B"
	$"3C3A3D2B350A0442274D2E4B2F4028050A010100000A020101000A000102000A"
	$"030403040506000A04010700"
};
